{
  "name": "cli-game",
  "version": "2.0.0",
  "description": "A Roguelike RPG built with rot-js and Phaser",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "game",
    "roguelike",
    "rpg",
    "phaser",
    "typescript"
  ],
  "license": "ISC",
  "dependencies": {
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rot-js": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.3"
  }
}
