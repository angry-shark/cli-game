{
  "name": "cli-game",
  "version": "2.0.0",
  "description": "A CLI Roguelike RPG built with rot-js and ink",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "tsx src/index.tsx",
    "dev": "tsx watch src/index.tsx",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "bin": {
    "cli_game": "dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "cli",
    "game",
    "roguelike",
    "rpg",
    "terminal",
    "typescript"
  ],
  "license": "ISC",
  "dependencies": {
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "rot-js": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18"
  }
}
