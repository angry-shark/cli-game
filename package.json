{
  "name": "cli-game-root",
  "version": "2.0.0",
  "description": "CLI Roguelike RPG Monorepo - Built with rot-js and ink",
  "private": true,
  "scripts": {
    "build": "pnpm --filter cli-game build",
    "dev": "pnpm --filter cli-game dev",
    "start": "pnpm --filter cli-game start",
    "typecheck": "pnpm --filter cli-game typecheck",
    "clean": "pnpm --filter cli-game clean && rm -rf node_modules"
  },
  "keywords": [
    "cli",
    "game",
    "roguelike",
    "rpg",
    "terminal",
    "rot-js",
    "ink"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.13.0",
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
